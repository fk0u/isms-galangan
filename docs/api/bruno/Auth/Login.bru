meta {
  name: Login
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body?.data?.token) bru.setEnvVar("token", res.body.data.token);
}

docs {
  Isi password di environment (variabel rahasia). Token hasil login disimpan ke {{token}}.
}
