meta {
  name: PUT rbac
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/rbac
  body: json
  auth: inherit
}

body:json {
  {
    "override": {
      "commercial": { "deny": ["sdm", "payroll"], "finTabs": ["Invoice"] }
    }
  }
}

docs {
  Hanya developer. override per peran menggantikan default; {} = kembali ke default. finTabs null = semua tab Keuangan.
}
