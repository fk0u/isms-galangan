meta {
  name: Related bookings
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/bookings/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - equipId -> equipment
  - equip -> equipment (lunak: id atau nama)
}
