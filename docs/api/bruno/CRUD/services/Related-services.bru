meta {
  name: Related services
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/services/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - projectId -> projects
  - vesselId -> vessels
  - boqRef -> boq
}
