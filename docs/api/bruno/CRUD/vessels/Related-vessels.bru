meta {
  name: Related vessels
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/vessels/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - owner -> clients (lunak: id atau nama)
  
  Dirujuk oleh:
  - services.vesselId
  - spareparts.vesselId
  - projects.vessel
  - dockSlots.vessel
  - surveys.vessel
  - warranties.vessel
  - invoices.vessel
  - quotations.vessel
}
