meta {
  name: Related requisitions
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/requisitions/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - itemId -> inventory
  - projectId -> projects
  
  Dirujuk oleh:
  - purchaseOrders.req
  - materialRequests.requisitionId
  - rfqs.prId
}
