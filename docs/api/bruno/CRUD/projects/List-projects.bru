meta {
  name: List projects
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/projects?limit=50
  body: none
  auth: inherit
}

params:query {
  limit: 50
}

docs {
  Daftar baris (terbaru dulu). Query opsional:
  - limit, offset, atau after=<cursor> (paginasi)
  - q (cari teks), branch (filter cabang)
  - where.<field>=<nilai> (filter persis, bisa berulang)
  
  Field relasi (merujuk koleksi lain):
  - plannedDockId -> drydocks
  - vessel -> vessels (lunak: id atau nama)
  - client -> clients (lunak: id atau nama)
  - manager -> employees (lunak: id atau nama)
  
  Dirujuk oleh:
  - invoices.project
  - services.projectId
  - spareparts.projectId
  - contracts.projectId
  - maintenances.projectId
  - dockSlots.project
  - documents.project
  - workOrders.project
  - ncr.project
  - inspections.project
  - requisitions.projectId
  - boq.projectId
  - checklistResponses.projectId
  - bomItems.projectId
  - materialRequests.projectId
  - boqDocs.projectId
  - changeOrders.project
  - risks.project
  - toolbox.project
  - drawings.project
  - warranties.projectId
  - bast.projectId
  - trials.projectId
  - clientPos.projectId
}
