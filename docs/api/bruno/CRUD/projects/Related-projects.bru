meta {
  name: Related projects
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/projects/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - plannedDockId -> drydocks
  - vessel -> vessels (lunak: id atau nama)
  - client -> clients (lunak: id atau nama)
  - manager -> employees (lunak: id atau nama)
  
  Dirujuk oleh:
  - invoices.project
  - services.projectId
  - spareparts.projectId
  - contracts.projectId
  - maintenances.projectId
  - dockSlots.project
  - documents.project
  - workOrders.project
  - ncr.project
  - inspections.project
  - requisitions.projectId
  - boq.projectId
  - checklistResponses.projectId
  - bomItems.projectId
  - materialRequests.projectId
  - boqDocs.projectId
  - changeOrders.project
  - risks.project
  - toolbox.project
  - drawings.project
  - warranties.projectId
  - bast.projectId
  - trials.projectId
  - clientPos.projectId
}
