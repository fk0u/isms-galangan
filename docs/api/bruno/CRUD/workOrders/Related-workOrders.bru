meta {
  name: Related workOrders
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/workOrders/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - project -> projects
  - sub -> subcontractors (lunak: id atau nama)
  
  Dirujuk oleh:
  - termins.woId
  - timesheets.woId
}
