meta {
  name: List workOrders
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/workOrders?limit=50
  body: none
  auth: inherit
}

params:query {
  limit: 50
}

docs {
  Daftar baris (terbaru dulu). Query opsional:
  - limit, offset, atau after=<cursor> (paginasi)
  - q (cari teks), branch (filter cabang)
  - where.<field>=<nilai> (filter persis, bisa berulang)
  
  Field relasi (merujuk koleksi lain):
  - project -> projects
  - sub -> subcontractors (lunak: id atau nama)
  
  Dirujuk oleh:
  - termins.woId
  - timesheets.woId
}
