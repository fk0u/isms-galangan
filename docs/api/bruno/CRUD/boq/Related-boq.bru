meta {
  name: Related boq
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/boq/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - projectId -> projects
  - boqDocId -> boqDocs
  
  Dirujuk oleh:
  - services.boqRef
}
