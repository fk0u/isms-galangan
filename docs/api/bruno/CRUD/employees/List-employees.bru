meta {
  name: List employees
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/employees?limit=50
  body: none
  auth: inherit
}

params:query {
  limit: 50
}

docs {
  Daftar baris (terbaru dulu). Query opsional:
  - limit, offset, atau after=<cursor> (paginasi)
  - q (cari teks), branch (filter cabang)
  - where.<field>=<nilai> (filter persis, bisa berulang)
  
  Dirujuk oleh:
  - timesheets.employeeId
  - letters.employeeId
  - payroll.employeeId
  - attendance.employeeId
  - leaves.employeeId
  - checklistResponses.employeeId
  - projects.manager
}
