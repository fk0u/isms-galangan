meta {
  name: Related contracts
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/contracts/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - quotationId -> quotations
  - projectId -> projects
  - client -> clients (lunak: id atau nama)
  
  Dirujuk oleh:
  - clientPos.contractId
}
