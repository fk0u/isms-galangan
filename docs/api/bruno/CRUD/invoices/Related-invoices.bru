meta {
  name: Related invoices
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/invoices/:id/related
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

docs {
  Semua baris koleksi lain yang merujuk baris ini.
  
  Field relasi (merujuk koleksi lain):
  - project -> projects
  - vessel -> vessels (lunak: id atau nama)
  - client -> clients (lunak: id atau nama)
}
