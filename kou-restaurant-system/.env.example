# Nomor WhatsApp format internasional tanpa "+" (contoh sintetis: 6281200000000).
# Format 08xx juga diterima, otomatis diubah ke 62xx.
NEXT_PUBLIC_WA_NUMBER=[NOMOR_WA]

# Domain produksi, dipakai untuk canonical URL, Open Graph, sitemap.
# Di Vercel boleh dikosongkan: otomatis pakai VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=[SITE_URL]

# Opsional: link demo PWA versi penuh. Kalau masih placeholder, tombolnya disembunyikan.
NEXT_PUBLIC_DEMO_URL=[LINK_DEMO]

# Opsional: link portofolio / LinkedIn Ghani. Kalau masih placeholder, link disembunyikan.
NEXT_PUBLIC_PORTFOLIO_URL=[LINK_PORTFOLIO]
