# Salin ke deploy/.env (JANGAN di-commit) lalu isi semua nilai.

# Port loopback web untuk varian nginx host (default 3110).
ISMS_WEB_PORT=3110

# Domain publik yang sudah diarahkan (A record) ke IP server.
ISMS_DOMAIN=isms.example.com
# Email untuk notifikasi sertifikat Let's Encrypt.
ACME_EMAIL=admin@example.com

# --- API ---
# Wajib >= 32 karakter acak:  openssl rand -hex 32
JWT_SECRET=
# Harus sama persis dengan origin publik.
WEB_ORIGINS=https://isms.example.com
DB_DIALECT=sqlite
# Opsional; >= 32 karakter bila diisi:  openssl rand -hex 24
SETUP_TOKEN=

# Akun demo per peran untuk presentasi klien. Isi password acak kuat,
# lalu ALLOW_SEED_LOGIN=true. Matikan (false) setelah ada akun riil.
ALLOW_SEED_LOGIN=true
SEED_PASSWORD_DIREKTUR=
SEED_PASSWORD_MANAGER=
SEED_PASSWORD_DEVELOPER=
SEED_PASSWORD_VIEWER=
SEED_PASSWORD_PROYEK=
