{
  "name": "isms-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "migrate:roles": "tsx --env-file-if-exists=.env scripts/migrate-roles.ts",
    "migrate:boq-docs": "tsx --env-file-if-exists=.env scripts/migrate-boq-docs.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "seed:bulk": "tsx --env-file-if-exists=.env src/seedBulk.ts",
    "seed:gen": "tsx scripts/gen-seed-data.ts",
    "seed:mirror": "tsx --env-file-if-exists=.env src/seedMirror.ts",
    "seed:reprice": "tsx --env-file-if-exists=.env src/seedReprice.ts",
    "audit:duplicates": "tsx --env-file-if-exists=.env src/auditDuplicates.ts",
    "seed:docs": "tsx --env-file-if-exists=.env src/seed.ts && tsx --env-file-if-exists=.env src/seedBulk.ts",
    "seed:whatif": "tsx --env-file-if-exists=.env src/seedWhatIf.ts",
    "backup": "tsx --env-file-if-exists=.env src/backup.ts",
    "restore": "tsx --env-file-if-exists=.env src/restore.ts",
    "probe:pdf": "tsx --env-file-if-exists=.env scripts/pdf-probe.ts",
    "probe:pdf-db": "tsx --env-file-if-exists=.env scripts/pdf-db-probe.ts",
    "probe:pdf-audit": "tsx --env-file-if-exists=.env scripts/pdf-audit-probe.ts",
    "probe:page": "tsx scripts/page-probe.ts",
    "probe:security": "tsx --env-file-if-exists=.env scripts/security-probe.ts",
    "probe:security-isolation": "tsx --env-file-if-exists=.env scripts/security-probe-isolation-probe.ts",
    "probe:tx": "tsx --env-file-if-exists=.env scripts/tx-probe.ts",
    "probe:env": "tsx scripts/env-probe.ts",
    "probe:users": "tsx --env-file-if-exists=.env scripts/user-hierarchy-probe.ts",
    "probe:token": "tsx --env-file-if-exists=.env scripts/token-revocation-probe.ts",
    "probe:branch": "tsx --env-file-if-exists=.env scripts/branch-scope-probe.ts",
    "probe:inventory-conversion": "tsx scripts/inventory-conversion-probe.ts",
    "probe:material": "tsx --env-file-if-exists=.env scripts/material-flow-probe.ts",
    "probe:service": "tsx --env-file-if-exists=.env scripts/service-flow-probe.ts",
    "probe:po-partial": "tsx --env-file-if-exists=.env scripts/po-partial-probe.ts",
    "probe:public-leave": "tsx --env-file-if-exists=.env scripts/public-leave-probe.ts",
    "probe:attendance-ingest": "tsx --env-file-if-exists=.env scripts/attendance-ingest-probe.ts",
    "probe:files-privacy": "tsx --env-file-if-exists=.env scripts/files-privacy-probe.ts",
    "probe:team-scope": "tsx --env-file-if-exists=.env scripts/team-scope-probe.ts",
    "probe:events": "tsx --env-file-if-exists=.env scripts/events-probe.ts",
    "probe:dock-fit": "tsx --env-file-if-exists=.env scripts/dock-fit-probe.ts",
    "probe:backup": "tsx --env-file-if-exists=.env scripts/backup-restore-probe.ts",
    "probe:concurrency": "tsx --env-file-if-exists=.env scripts/concurrency-probe.ts",
    "probe:change-order": "tsx --env-file-if-exists=.env scripts/change-order-probe.ts",
    "probe:checklist": "tsx --env-file-if-exists=.env scripts/checklist-probe.ts",
    "probe:equipment-loan": "tsx --env-file-if-exists=.env scripts/equipment-loan-probe.ts",
    "probe:inventory-issue": "tsx --env-file-if-exists=.env scripts/inventory-issue-probe.ts",
    "probe:wo-spk": "tsx --env-file-if-exists=.env scripts/wo-spk-probe.ts",
    "probe:demo-roles": "tsx --env-file-if-exists=.env scripts/demo-roles-probe.ts",
    "probe:boq": "tsx --env-file-if-exists=.env scripts/boq-docs-probe.ts",
    "probe:voucher": "tsx --env-file-if-exists=.env scripts/voucher-probe.ts",
    "probe:hr-letter": "tsx --env-file-if-exists=.env scripts/hr-letter-probe.ts",
    "probe:relations": "tsx --env-file-if-exists=.env scripts/relations-probe.ts",
    "gen:bruno": "tsx --env-file-if-exists=.env scripts/gen-bruno.ts",
    "probe:bruno": "tsx --env-file-if-exists=.env scripts/gen-bruno.ts --check",
    "sync:boq-documents": "tsx --env-file-if-exists=.env scripts/sync-boq-documents.ts",
    "sync:voucher-numbers": "tsx --env-file-if-exists=.env scripts/sync-voucher-numbers.ts",
    "probe:drydock": "tsx --env-file-if-exists=.env scripts/drydock-booking-probe.ts",
    "probe:boq-migration": "tsx --env-file-if-exists=.env scripts/boq-migration-probe.ts",
    "lint": "eslint . --max-warnings=29",
    "check": "tsc --noEmit && npm run lint && npm test && npm run probe:pdf && npm run probe:page && npm run probe:tx && npm run probe:env && npm run probe:users && npm run probe:token && npm run probe:branch && npm run probe:inventory-conversion && npm run probe:security-isolation && npm run probe:security && npm run probe:boq && npm run probe:voucher && npm run probe:hr-letter && npm run probe:relations && npm run probe:bruno && npm run probe:boq-migration && npm run probe:drydock && npm run probe:material && npm run probe:service && npm run probe:po-partial && npm run probe:demo-roles && npm run probe:wo-spk && npm run probe:inventory-issue && npm run probe:equipment-loan && npm run probe:checklist && npm run probe:change-order && npm run probe:concurrency && npm run probe:backup && npm run probe:dock-fit && npm run probe:events && npm run probe:public-leave && npm run probe:attendance-ingest && npm run probe:files-privacy && npm run probe:team-scope && npm run probe:domain-guards && npm run probe:read-models && npm run probe:cache && npm run probe:pdf-audit",
    "test": "vitest run",
    "probe:domain-guards": "tsx --env-file-if-exists=.env scripts/domain-guards-probe.ts",
    "probe:read-models": "tsx --env-file-if-exists=.env scripts/read-models-probe.ts",
    "probe:cache": "tsx --env-file-if-exists=.env scripts/cache-probe.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "mysql2": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
