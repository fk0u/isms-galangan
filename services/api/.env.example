# ISMS API Environment (dimuat otomatis via Node --env-file=.env bawaan, Node >= 22)
PORT=3000
DB_DIALECT=sqlite
SQLITE_PATH=./data/isms.db
# DB_DIALECT=mysql
# MYSQL_URL=mysql://user:pass@localhost:3306/isms
# JWT_SECRET is REQUIRED (min 32 characters, non-example value).
# Ganti dengan string acak kuat (mis. openssl rand -base64 32). Nilai contoh akan ditolak saat boot.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-yang-kuat
# Runtime: development | test | production (default: development).
NODE_ENV=development
# Upload storage dir (created at boot; must be writable; checked by GET /health).
UPLOADS_DIR=./data/uploads
# CORS allowlist (comma-separated URL eksplisit). Wajib diisi kecuali NODE_ENV=development dan HOST localhost.
# Wildcard "*" dilarang keras.
WEB_ORIGINS=http://localhost:5173
# SETUP_TOKEN guards POST /api/admin/seed (fail-closed 403 when missing/wrong).
# Bila diisi, wajib minimal 32 karakter.
# SETUP_TOKEN=ganti-dengan-token-acak-minimal-32-karakter-yang-kuat
# Only trust x-forwarded-for for rate-limit/audit IPs behind a real proxy.
# TRUST_PROXY=true
# TRUST_PROXY must be "true" or "false" — anything else throws at boot.
# Demo seed accounts cannot log in in production unless explicitly allowed.
# ALLOW_SEED_LOGIN=false
# ALLOW_SEED_LOGIN must be "true" or "false" — anything else throws at boot.

