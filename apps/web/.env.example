# Salin ke .env untuk mengaktifkan mode backend (remote).
# Tanpa file .env ini, frontend berjalan mode lokal (seed + localStorage).
VITE_API_URL=http://localhost:3000

# Field tarif pakai dan harga BBM equipment tersembunyi secara default.
# Vite mengekspos konfigurasi frontend melalui prefiks VITE_.
VITE_SHOW_EQP_COST_FIELDS=0

# Petunjuk "Daftarkan alat" absensi (opsional): alamat & port yang diisi di
# menu Server mesin Fingerspot/ADMS. Default: host aplikasi ini & port 8013.
# Isi IP server bila mesin tidak menerima nama domain.
VITE_ATTENDANCE_DEVICE_HOST=
VITE_ATTENDANCE_DEVICE_PORT=8013
