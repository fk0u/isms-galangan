# Salin ke .env untuk mengaktifkan mode backend (remote).
# Tanpa file .env ini, frontend berjalan mode lokal (seed + localStorage).
VITE_API_URL=http://localhost:3000

# Field tarif pakai dan harga BBM equipment tersembunyi secara default.
# Vite mengekspos konfigurasi frontend melalui prefiks VITE_.
VITE_SHOW_EQP_COST_FIELDS=0
